<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef>
		<defName>Shell_Deadlife_ReleasingSTNL</defName>
		<label>deadlife capsule</label>
		<selectable>false</selectable>
		<tickerType>Normal</tickerType>
		<thingClass>ThingWithComps</thingClass>
		<useHitPoints>false</useHitPoints>
		<graphicData>
			<texPath>Things/Projectile/LandedDeadlifeShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>Transparent</shaderType>
		</graphicData>
		<rotatable>false</rotatable>
		<comps>
			<li Class="SentinelFramework_STNL.CompProps_GasEmitter">
				<gasType>DeadlifeDust</gasType>
				<radius>7.9</radius>
				<deadlifeGasQuantity>500</deadlifeGasQuantity>
				<radiusColor>(0.7,0.7,0.7)</radiusColor>
			</li>
			<li Class="CompProperties_DestroyAfterDelay">
				<delayTicks>600</delayTicks>
			</li>
		</comps>
	</ThingDef>
	
	<!-- Actual gasses -->

<ThingDef ParentName="VPE_SentinelFramework_Gas_STNL">
	<defName>VPE_Deadlife_CrimsonDeadlifeDust_STNL</defName>
	<label>Crimson deadlife dust</label>
	<thingClass>VPE_Deadlife.CustomGas_Deadlife_STNL</thingClass>
	<graphicData>
		<texPath>Things/Mote/Smoke</texPath>
		<drawSize>4</drawSize>
		<color>(0.5, 0.2, 0.2, 1)</color>
	</graphicData>
	<gas>
		<expireSeconds>19~21</expireSeconds>
		<rotationSpeed>10</rotationSpeed>
	</gas>
	<modExtensions>
		<li Class="SentinelFramework_STNL.GasModExt">
			<gasEffectDelay>10</gasEffectDelay>
		</li>
	</modExtensions>
</ThingDef>

<!-- Corpse converter -->

